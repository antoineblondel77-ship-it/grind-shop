{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "GRIND — boutique Drop 001",
		"description": "Maquette WooCommerce du thème GRIND.",
		"author": "antoineblondel77-ship-it"
	},
	"landingPage": "/",
	"preferredVersions": {
		"php": "8.2",
		"wp": "latest"
	},
	"features": {
		"networking": true
	},
	"login": true,
	"steps": [
		{
			"step": "setSiteLanguage",
			"language": "fr_FR"
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "wordpress.org/plugins",
				"slug": "woocommerce"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "installTheme",
			"themeData": {
				"resource": "git:directory",
				"url": "https://github.com/antoineblondel77-ship-it/grind-shop",
				"ref": "main",
				"refType": "branch"
			},
			"options": {
				"activate": true,
				"targetFolderName": "grind"
			}
		},
		{
			"step": "runPHP",
			"code": "<?php require '/wordpress/wp-load.php'; require get_stylesheet_directory() . '/playground/setup.php';"
		}
	]
}
